# Sparkling backend environment template
# 复制为 backend/.env 后按本地环境调整。
#
# 说明：
# - backend/.env 主要用于本地开发；Docker 镜像默认值写在 Dockerfile/docker-compose.yml 中。
# - 前端 Vite dev server 会读取这里的 SPARKLING_PORT 来代理 /api 和 /ws。
# - AI Provider（Embedding / Chat / Trend）的 base_url、api_key、model、dim 不放在 .env，
#   请在 Settings 页面配置；这些设置会保存到当前选择的业务数据库中。

# ---------------------------------------------------------------------------
# Default SQLite bootstrap
# ---------------------------------------------------------------------------
# 默认 SQLite 业务数据库文件路径。这里不要使用 SQLAlchemy URL（例如 sqlite:///...）。
# 首次启动且 control DB 中还没有数据库配置时，后端会把这个路径写入 control DB。
# 之后实际使用哪个数据库，以 Settings → Database 保存到 control DB 的配置为准。
# PostgreSQL URL 不再通过 .env 配置，请在 Settings 页面填写并保存。
# 本地开发推荐保存在 backend 目录下；Docker 中默认使用 /data/sparkling.db。
SPARKLING_DB_PATH=./sparkling.db

# 固定本地 control SQLite，用于保存：
# - 当前选择的业务数据库配置（支持热切换）
# - 单用户认证数据和 session
# 不要和业务数据库共用同一个文件。
# Docker 中默认使用 /data/control.db。
SPARKLING_CONTROL_DB_PATH=./control.db

# 统一日志目录。本地默认 backend/logs；Docker 建议使用持久化 volume 内的 /data/logs。
SPARKLING_LOG_DIR=./logs
# 单个日志文件上限、每类日志 backup 数量，以及整个日志目录总上限。
SPARKLING_LOG_MAX_FILE_MB=10
SPARKLING_LOG_BACKUP_COUNT=9
SPARKLING_LOG_MAX_TOTAL_MB=200

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# 后端监听地址。
# 本地开发建议 127.0.0.1；Docker 容器内必须使用 0.0.0.0。
SPARKLING_HOST=127.0.0.1

# 后端监听端口。
# 本地前端 dev server 会读取该值并代理到此端口；Docker 默认暴露 3721。
SPARKLING_PORT=3721

# 前端 dev server 的 CORS origin。
# 本地开发保留 http://localhost:5173；生产/Docker 静态前端同源部署时可留空。
SPARKLING_DEV_ORIGIN=http://localhost:5173

# 可信反向代理的 IP 或 CIDR，多个值用英文逗号分隔。
# Docker 部署时填写 OpenResty 所在网段，例如 172.18.0.0/16。
# FORWARDED_ALLOW_IPS=172.18.0.0/16
