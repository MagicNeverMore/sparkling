# 复制为 .env 后按本地环境调整。

# 数据库后端：sqlite 或 postgresql。
SPARKLING_DB_BACKEND=sqlite

# SQLite 文件路径。这里不要使用 SQLAlchemy URL。
SPARKLING_DB_PATH=./sparkling.db

# PostgreSQL 连接串。仅 SPARKLING_DB_BACKEND=postgresql 时使用。
SPARKLING_POSTGRESQL_URL=

# 运行时数据库选择存放位置；不要和业务数据库共用。
SPARKLING_CONTROL_DB_PATH=./control.db

# 后端监听地址。
SPARKLING_HOST=127.0.0.1
SPARKLING_PORT=3721

# 前端 dev server 的 CORS origin。
SPARKLING_DEV_ORIGIN=http://localhost:5173
